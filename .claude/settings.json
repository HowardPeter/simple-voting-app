{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(file:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(npm ls:*)",
      "Bash(terraform validate)"
    ],
    "ask": [
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(npx prisma:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(**/*.tfvars)",
      "Read(**/.env)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)"
    ]
  }
}
