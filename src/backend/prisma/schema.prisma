generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String   @id @default(cuid())
  /// 5-digit join code, generated by the application.
  code      String   @unique @db.Char(5)
  /// Nullable because the room is created before its owner user.
  ownerId   String?  @unique
  owner     User?    @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  users  User[]
  topics Topic[]
}

model User {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  token     String   @unique
  createdAt DateTime @default(now())

  ownedRoom Room?  @relation("RoomOwner")
  votes     Vote[]

  @@index([roomId])
}

model Topic {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title     String
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())

  options Option[]
  votes   Vote[]

  @@index([roomId])
}

model Option {
  id       String @id @default(cuid())
  topicId  String
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  label    String
  position Int

  votes Vote[]

  @@unique([topicId, position])
}

model Vote {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  option    Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([topicId, userId])
  @@index([userId])
  @@index([optionId])
}
